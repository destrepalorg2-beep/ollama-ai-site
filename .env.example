# Copy this file to .env.local and fill in the real values.
# .env.local is git-ignored — the token must never be committed or pasted
# into a chat. If it leaks, revoke it in @BotFather with /revoke.

# Public: the bot's @username. Safe in the browser, anyone can see it anyway.
NEXT_PUBLIC_TG_BOT=paybotayhub_bot

# SECRET: full control of the bot. Server-side only — never prefix it with
# NEXT_PUBLIC_, or Next.js will ship it to every visitor's browser.
TELEGRAM_BOT_TOKEN=

# SECRET: any random string. Telegram sends it back in the
# X-Telegram-Bot-Api-Secret-Token header so the webhook can reject fakes.
TELEGRAM_WEBHOOK_SECRET=
